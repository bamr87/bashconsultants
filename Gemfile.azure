source "https://rubygems.org"

# Gemfile for Azure builds: uses the local gem theme instead of remote_theme

gem 'github-pages'

# Theme loaded as a local gem for Azure (no remote_theme)
gem 'jekyll-theme-zer0'

group :jekyll_plugins do
  # Keep other plugins, but omit jekyll-remote-theme for Azure
  gem 'jekyll-feed'
  gem 'jekyll-sitemap'
  gem 'jekyll-seo-tag'
  gem 'jekyll-paginate'
end

# Docker support
gem "ffi"
gem 'webrick'
gem 'commonmarker', '0.23.10'
