{
  "name": "@bashos/cli",
  "version": "0.0.1",
  "private": true,
  "description": "BASH OS — AI engine CLI: runs the prompt library against the working tree with Claude, gated by the autonomy policy.",
  "type": "module",
  "bin": {
    "bashos": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node --experimental-strip-types src/index.ts",
