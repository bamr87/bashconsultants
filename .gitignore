# Jekyll build output
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# Bundler
.bundle/
vendor/
Gemfile.lock
Gemfile.azure.lock

# Environment
env-variables.log
*.DS_Store

# Extension (in extension/ directory)
extension/node_modules/
extension/out/
extension/dist/
extension/.vscode-test/
extension/*.vsix

# Lock files (generated)
package-lock.json
logs/
.env
.venv/
__pycache__/

# Pre-enhance backup images (originals before AI enhancement)
*_pre-enhance.png

# FrontMatter CMS local database (generated by VS Code extension)
.frontmatter/database/

# Playwright MCP runtime artifacts (console/page snapshots from agent sessions)
.playwright-mcp/

# Generated at build time by _plugins/content_statistics_generator.rb
_data/content_statistics.yml

# Content loop: the local SessionEnd trace queue (folded into
# _data/loop/sessions.jsonl by `scripts/loop/trace.py --sync`) and the
# planner's per-run working directory (plan.json / digest.md).
.claude/loop/
.loop/
