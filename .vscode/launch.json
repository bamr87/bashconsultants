// bashconsultants · .vscode/launch.json — fleet-vscode/v1 · 2026-09-09. Convention + vocabulary: .vscode/README.md.
// webRoot is the served build output (_site), so breakpoints in served files bind; the server on :4042 comes from the Serve task.
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: site in Edge (:4042)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:4042",
      "webRoot": "${workspaceFolder}/_site",
      "preLaunchTask": "Serve"
    },
    {
      "name": "Debug: live site (bash-365.com)",
      "type": "msedge",
      "request": "launch",
      "url": "https://bash-365.com"
    }
  ]
}
