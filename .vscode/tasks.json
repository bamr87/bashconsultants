// bashconsultants · .vscode/tasks.json — fleet-vscode/v1 · 2026-09-09. Convention + vocabulary: .vscode/README.md.
// The Jekyll tasks run in Docker because the host Ruby is newer than the github-pages gem supports; Docker Desktop must be RUNNING (`docker info` hangs rather than errors when it is down, so a task that sits silent means: start Docker first).
// `docker compose` (v2) everywhere, never `docker-compose`.
// The `Preview images: … (xAI)` tasks call scripts/features/xai-login, which arrives with the preview-image work still unpushed on the author's local main — they are inert until that lands.
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Serve",
      "detail": "Docker. The Jekyll dev stack (_config.yml,_config_dev.yml) on http://localhost:4042 with livereload on :35730 — the only stack where _plugins/ execute. Runs until Stop.",
      "type": "shell",
      "command": "docker compose up",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "owner": "serve",
        "pattern": {
          "regexp": "^(never-matches)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Server (running|address)|Container \\S+\\s+Running"
        }
      }
    },
    {
      "label": "Stop",
      "detail": "Stops and removes the dev stack (docker compose down).",
      "type": "shell",
      "command": "docker compose down",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build",
      "detail": "Docker. The GitHub Pages stack build exactly as build-validate.yml runs it (_config.yml alone, remote theme, safe mode, → _site-pages). The Azure stack needs Gemfile.azure and stays CI-only.",
      "type": "shell",
      "command": "docker compose up -d && docker compose exec -T jekyll bundle exec jekyll build --trace --config _config.yml --destination _site-pages",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Build: dev stack",
      "detail": "Docker. The local-dev build from CLAUDE.md operating rule 2 — a developer check CI never runs; a change that builds only under _config_dev.yml can still be broken in production.",
      "type": "shell",
      "command": "docker compose up -d && docker compose exec -T jekyll bundle exec jekyll build --config _config.yml,_config_dev.yml",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Lint",
      "detail": "Host python. The editorial gate (self-test, then the whole repo; exit 1 on errors) — the same two steps build-validate.yml runs first.",
      "type": "shell",
      "command": "python3 scripts/content_lint.py --self-test && python3 scripts/content_lint.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Verify",
      "detail": "Lint, then the Pages-stack Build — the required build-validate check minus the Azure stack.",
      "dependsOn": [
        "Lint",
        "Build"
      ],
      "dependsOrder": "sequence",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Extension: lint + compile",
      "detail": "Host node. CLAUDE.md operating rule 2 for extension/ changes.",
      "type": "shell",
      "command": "npm run lint && npm run compile",
      "options": {
        "cwd": "${workspaceFolder}/extension"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Preview images: list missing",
      "detail": "Host. Posts/docs without a preview image — no API calls.",
      "type": "shell",
      "command": "./scripts/generate-preview-images.sh --list-missing",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Preview images: dry run",
      "detail": "Host. What would be generated, prompts included — no API spend.",
      "type": "shell",
      "command": "./scripts/generate-preview-images.sh --dry-run --verbose",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Preview images: generate",
      "detail": "Host. Generates previews for the chosen collection — costs API credits.",
      "type": "shell",
      "command": "./scripts/generate-preview-images.sh --collection ${input:collection} --verbose",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Preview images: xAI login",
      "detail": "Host. Mints the xAI subscription OAuth token (device-code flow) that --provider xai reads. Run once; the token is reused until it expires.",
      "type": "shell",
      "command": "./scripts/features/xai-login",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Preview images: generate (xAI)",
      "detail": "Host. Generates previews through xAI Imagine on the subscription token — run the xAI login task first.",
      "type": "shell",
      "command": "./scripts/generate-preview-images.sh --provider xai --collection ${input:collection} --verbose",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Claude: session",
      "detail": "Interactive Claude Code in this repo with its .claude/agents + skills, on your logged-in credentials. House rules still apply: branch from main, open a PR, a human merges.",
      "type": "shell",
      "command": "claude",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      }
    }
  ],
  "inputs": [
    {
      "id": "collection",
      "type": "pickString",
      "description": "Which collection?",
      "options": [
        "posts",
        "all"
      ],
      "default": "posts"
    }
  ]
}
