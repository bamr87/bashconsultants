// BASH Consultants Jekyll site settings
{
    "files.exclude": {
        "_site": true,
        ".sass-cache": true,
        ".jekyll-cache": true,
        "extension/node_modules": true,
        "extension/out": true,
        "extension/dist": true
    },
    "search.exclude": {
        "_site": true,
        "extension/node_modules": true,
        "extension/out": true,
        "extension/dist": true
    },
    "files.associations": {
        "*.html": "liquid"
    },
    // BASH-CMS (the sibling VS Code extension, github.com/bamr87/bash-cms)
    // publishing against this workspace — same queue, ledger, and canonical
    // host as scripts/features/linkedin/. Publishing stays off by default.
    "bashCms.linkedin.orgUrn": "urn:li:organization:64517157",
    "bashCms.site.baseUrl": "https://bash-365.com",
    "bashCms.publish.allow": false
}